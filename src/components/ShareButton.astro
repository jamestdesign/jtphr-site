---
interface Props {
  shareId: string;
}
const { shareId } = Astro.props;
const shareUrl = `https://jtphr-site.vercel.app/s/${shareId}`;
---

<button
  class="share-btn inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-full border border-white/10 text-text-muted hover:border-accent hover:text-accent transition-colors"
  data-url={shareUrl}
  title="複製分享連結"
>
  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
  </svg>
  <span class="share-label">分享</span>
</button>

<script is:inline>
  document.querySelectorAll('.share-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url;
      const label = btn.querySelector('.share-label');
      try {
        await navigator.clipboard.writeText(url);
        label.textContent = '已複製！';
        btn.classList.add('border-green-500', 'text-green-400');
        btn.classList.remove('border-white/10', 'text-text-muted');
        setTimeout(() => {
          label.textContent = '分享';
          btn.classList.remove('border-green-500', 'text-green-400');
          btn.classList.add('border-white/10', 'text-text-muted');
        }, 2000);
      } catch {
        // Fallback for mobile
        const input = document.createElement('input');
        input.value = url;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        label.textContent = '已複製！';
        setTimeout(() => label.textContent = '分享', 2000);
      }
    });
  });
</script>
