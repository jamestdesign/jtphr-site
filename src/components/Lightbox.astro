<!-- Lightbox: click image thumbnail → fullscreen overlay -->
<div id="lightbox" class="fixed inset-0 z-[100] bg-black/90 backdrop-blur-sm hidden items-center justify-center cursor-zoom-out" onclick="this.classList.add('hidden');this.classList.remove('flex')">
  <img id="lightbox-img" class="max-w-[90vw] max-h-[90vh] object-contain rounded-lg shadow-2xl" />
  <button class="absolute top-6 right-6 text-white/60 hover:text-white text-3xl">&times;</button>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightbox') as HTMLElement;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;

    // Target all images inside prose content
    document.querySelectorAll('.prose img').forEach(img => {
      const el = img as HTMLImageElement;
      // Style as thumbnail
      el.style.cursor = 'zoom-in';
      el.style.maxHeight = '300px';
      el.style.width = 'auto';
      el.style.objectFit = 'contain';

      el.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        lightboxImg.src = el.src;
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      });
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        lightbox.classList.add('hidden');
        lightbox.classList.remove('flex');
      }
    });
  });
</script>
