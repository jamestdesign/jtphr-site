---
import ShareLayout from '../../layouts/ShareLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const shares = await getCollection('share');
  return shares.map(s => ({
    params: { id: s.id },
    props: { entry: s },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ShareLayout title={entry.data.title} description={`${entry.data.title}`}>
  <article>
    <div class="mb-8 pb-6 border-b border-white/5">
      <h1 class="text-3xl md:text-4xl font-bold leading-tight">{entry.data.title}</h1>
      {entry.data.date && (
        <p class="text-xs text-text-muted/40 mt-2">
          {new Date(entry.data.date).toLocaleDateString('zh-TW')}
        </p>
      )}
    </div>

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:text-text prose-headings:font-bold
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-white/5
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-text-muted prose-p:leading-relaxed
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-strong:text-text
      prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
      prose-pre:bg-brand prose-pre:border prose-pre:border-white/5 prose-pre:rounded-lg
      prose-blockquote:border-accent prose-blockquote:bg-white/3 prose-blockquote:rounded-r-lg prose-blockquote:py-1
      prose-table:text-sm
      prose-th:text-text prose-th:bg-white/5 prose-th:px-3 prose-th:py-2
      prose-td:px-3 prose-td:py-2 prose-td:border-white/5
      prose-li:text-text-muted
      prose-img:rounded-lg
    ">
      <Content />
    </div>
  </article>
  <Lightbox />
</ShareLayout>
