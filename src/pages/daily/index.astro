---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allDaily = await getCollection('daily');
const dailies = allDaily.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="每日財經日報" description="JTpHR 每日財經日報 — AI 整理的台股盤後分析">
  <section class="max-w-4xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold mb-2">每日財經日報</h1>
    <p class="text-text-muted mb-12">AI 整理，方便閱讀與聆聽</p>

    <div class="space-y-4">
      {dailies.map(d => (
        <a href={`/daily/${d.id}`} class="block p-6 rounded-lg bg-brand-light border border-white/5 hover:border-accent/30 transition-all group">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs text-text-muted/50 mb-1">
                {new Date(d.data.date).toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' })}
              </p>
              <h2 class="text-lg font-bold group-hover:text-accent transition-colors">{d.data.title}</h2>
              {d.data.source && (
                <p class="text-xs text-text-muted/40 mt-1">來源：{d.data.source}</p>
              )}
            </div>
            <div class="flex items-center gap-3">
              {d.data.audio && (
                <span class="text-xs px-2 py-1 rounded bg-accent/10 text-accent">🎙 Podcast</span>
              )}
              <span class="text-text-muted/30 group-hover:text-accent transition-colors text-xl">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    {dailies.length === 0 && (
      <p class="text-center text-text-muted py-12">尚無日報</p>
    )}
  </section>
</BaseLayout>
