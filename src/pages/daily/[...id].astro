---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const dailies = await getCollection('daily');
  return dailies.map(d => ({
    params: { id: d.id },
    props: { entry: d },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const dateStr = new Date(entry.data.date).toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
});
---

<BaseLayout title={`${dateStr} — 每日財經日報`} description={`${dateStr} 台股盤後分析`}>
  <div class="max-w-5xl mx-auto px-6 py-24">
    <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
      <!-- Main Content -->
      <article>
        <!-- Header -->
        <div class="mb-8 pb-8 border-b border-white/5">
          <a href="/daily" class="text-xs text-text-muted hover:text-accent transition-colors mb-4 inline-block">&larr; 所有日報</a>
          <p class="text-sm text-accent mb-2">{dateStr}</p>
          <h1 class="text-3xl md:text-4xl font-bold">{entry.data.title}</h1>
          {entry.data.source && (
            <p class="text-xs text-text-muted/50 mt-2">來源：{entry.data.source}</p>
          )}
        </div>

        <!-- Audio Player -->
        {entry.data.audio && (
          <div class="mb-8 p-4 rounded-lg bg-brand-light border border-white/5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm font-medium">🎙 Podcast 播放</p>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-text-muted/50">速度</span>
                {[0.75, 1, 1.25, 1.5, 2].map(speed => (
                  <button
                    class={`speed-btn text-[11px] px-2 py-0.5 rounded transition-colors ${speed === 1 ? 'bg-accent text-white' : 'bg-white/5 text-text-muted hover:bg-accent/20 hover:text-accent'}`}
                    data-speed={speed}
                  >
                    {speed}x
                  </button>
                ))}
              </div>
            </div>
            <audio id="main-player" controls class="w-full" preload="metadata">
              <source src={entry.data.audio} type="audio/mpeg" />
              你的瀏覽器不支援音檔播放
            </audio>
          </div>
        )}

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:text-text prose-headings:font-bold prose-headings:scroll-mt-20
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-white/5
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-text-muted prose-p:leading-relaxed
          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
          prose-strong:text-text
          prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
          prose-blockquote:border-accent prose-blockquote:bg-white/3 prose-blockquote:rounded-r-lg prose-blockquote:py-1
          prose-li:text-text-muted
          prose-hr:border-white/5
        ">
          <Content />
        </div>
      </article>

      <!-- Sidebar: Table of Contents -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <p class="text-xs font-bold text-text-muted/50 uppercase tracking-wider mb-4">目錄</p>
          <nav class="space-y-1">
            {headings.filter(h => h.depth === 2).map((h, i) => (
              <div class="flex items-center gap-1">
                <button
                  class="section-play flex-shrink-0 w-6 h-6 rounded-full bg-white/5 hover:bg-accent/20 text-text-muted/40 hover:text-accent transition-colors flex items-center justify-center text-[10px]"
                  data-section={h.slug}
                  data-index={i + 1}
                  title={`播放：${h.text}`}
                >
                  ▶
                </button>
                <a
                  href={`#${h.slug}`}
                  class="toc-link block text-sm text-text-muted/60 hover:text-accent transition-colors py-1.5 border-l-2 border-transparent hover:border-accent pl-2"
                  data-slug={h.slug}
                >
                  {h.text}
                </a>
              </div>
            ))}
          </nav>

          {entry.data.audio && (
            <div class="mt-8 pt-8 border-t border-white/5">
              <p class="text-xs font-bold text-text-muted/50 uppercase tracking-wider mb-3">快速聽</p>
              <audio controls class="w-full" preload="metadata" style="height: 36px;">
                <source src={entry.data.audio} type="audio/mpeg" />
              </audio>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>

  <!-- Speed control + Highlight active TOC item on scroll -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Speed control
      const mainPlayer = document.getElementById('main-player');
      const sidePlayer = document.querySelector('aside audio');
      const speedBtns = document.querySelectorAll('.speed-btn');

      speedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const speed = parseFloat(btn.dataset.speed);
          if (mainPlayer) mainPlayer.playbackRate = speed;
          if (sidePlayer) sidePlayer.playbackRate = speed;
          speedBtns.forEach(b => {
            b.classList.remove('bg-accent', 'text-white');
            b.classList.add('bg-white/5', 'text-text-muted');
          });
          btn.classList.add('bg-accent', 'text-white');
          btn.classList.remove('bg-white/5', 'text-text-muted');
        });
      });

      // Section audio player
      const sectionPlayer = new Audio();
      let currentSection = null;
      const sectionBtns = document.querySelectorAll('.section-play');

      // Build section audio map from headings
      const h2s = document.querySelectorAll('.prose h2[id]');
      const sectionSlugs = Array.from(h2s).map(h => h.id);

      // Audio base path: /audio/YYYY-MM-DD/
      const audioBase = mainPlayer ? mainPlayer.querySelector('source')?.src.replace('.mp3', '') + '/' : '';
      const dateMatch = window.location.pathname.match(/(\d{4}-\d{2}-\d{2})/);
      const dateStr = dateMatch ? dateMatch[1] : '';
      const sectionAudioBase = `/audio/${dateStr}/`;

      sectionBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(btn.dataset.index);
          const slug = btn.dataset.section;
          const paddedIdx = String(idx).padStart(2, '0');

          // Find matching audio file
          const audioSrc = `${sectionAudioBase}${paddedIdx}-${slug}.mp3`;

          if (currentSection === slug && !sectionPlayer.paused) {
            sectionPlayer.pause();
            btn.textContent = '▶';
            currentSection = null;
            return;
          }

          // Stop all other buttons
          sectionBtns.forEach(b => b.textContent = '▶');
          if (mainPlayer) mainPlayer.pause();

          sectionPlayer.src = audioSrc;
          sectionPlayer.playbackRate = mainPlayer ? mainPlayer.playbackRate : 1;
          sectionPlayer.play();
          btn.textContent = '⏸';
          currentSection = slug;

          // Scroll to section
          const target = document.getElementById(slug);
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      sectionPlayer.addEventListener('ended', () => {
        sectionBtns.forEach(b => b.textContent = '▶');
        currentSection = null;
      });

      // Sync side player with main player
      if (mainPlayer && sidePlayer) {
        mainPlayer.addEventListener('timeupdate', () => {
          if (Math.abs(sidePlayer.currentTime - mainPlayer.currentTime) > 1) {
            sidePlayer.currentTime = mainPlayer.currentTime;
          }
        });
        sidePlayer.addEventListener('play', () => { mainPlayer.currentTime = sidePlayer.currentTime; mainPlayer.play(); });
        sidePlayer.addEventListener('pause', () => mainPlayer.pause());
      }
      const tocLinks = document.querySelectorAll('.toc-link');
      const headings = document.querySelectorAll('.prose h2[id]');

      if (!headings.length || !tocLinks.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              tocLinks.forEach(link => {
                link.classList.remove('text-accent', 'border-accent');
                link.classList.add('text-text-muted/60', 'border-transparent');
              });
              const active = document.querySelector(`.toc-link[data-slug="${entry.target.id}"]`);
              if (active) {
                active.classList.add('text-accent', 'border-accent');
                active.classList.remove('text-text-muted/60', 'border-transparent');
              }
            }
          });
        },
        { rootMargin: '-80px 0px -60% 0px' }
      );

      headings.forEach(h => observer.observe(h));
    });
  </script>
</BaseLayout>
