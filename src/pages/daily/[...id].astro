---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const dailies = await getCollection('daily');
  return dailies.map(d => ({
    params: { id: d.id },
    props: { entry: d },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const dateStr = new Date(entry.data.date).toLocaleDateString('zh-TW', {
  year: 'numeric', month: 'long', day: 'numeric', weekday: 'long'
});
---

<BaseLayout title={`${dateStr} — 每日財經日報`} description={`${dateStr} 台股盤後分析`}>
  <div class="max-w-5xl mx-auto px-6 py-24">
    <div class="lg:grid lg:grid-cols-[1fr_240px] lg:gap-12">
      <!-- Main Content -->
      <article>
        <!-- Header -->
        <div class="mb-8 pb-8 border-b border-white/5">
          <a href="/daily" class="text-xs text-text-muted hover:text-accent transition-colors mb-4 inline-block">&larr; 所有日報</a>
          <p class="text-sm text-accent mb-2">{dateStr}</p>
          <h1 class="text-3xl md:text-4xl font-bold">{entry.data.title}</h1>
          {entry.data.source && (
            <p class="text-xs text-text-muted/50 mt-2">來源：{entry.data.source}</p>
          )}
        </div>

        <!-- Audio Player -->
        {entry.data.audio && (
          <div class="mb-8 p-4 rounded-lg bg-brand-light border border-white/5">
            <div class="flex items-center justify-between mb-3">
              <p class="text-sm font-medium">🎙 Podcast 播放</p>
              <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-text-muted/50">速度</span>
                {[0.75, 1, 1.25, 1.5, 2].map(speed => (
                  <button
                    class={`speed-btn text-[11px] px-2 py-0.5 rounded transition-colors ${speed === 1 ? 'bg-accent text-white' : 'bg-white/5 text-text-muted hover:bg-accent/20 hover:text-accent'}`}
                    data-speed={speed}
                  >
                    {speed}x
                  </button>
                ))}
              </div>
            </div>
            <audio id="main-player" controls class="w-full" preload="metadata">
              <source src={entry.data.audio} type="audio/mpeg" />
              你的瀏覽器不支援音檔播放
            </audio>
          </div>
        )}

        <!-- Content -->
        <div class="prose prose-invert prose-lg max-w-none
          prose-headings:text-text prose-headings:font-bold prose-headings:scroll-mt-20
          prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-white/5
          prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-text-muted prose-p:leading-relaxed
          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
          prose-strong:text-text
          prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
          prose-blockquote:border-accent prose-blockquote:bg-white/3 prose-blockquote:rounded-r-lg prose-blockquote:py-1
          prose-li:text-text-muted
          prose-hr:border-white/5
        ">
          <Content />
        </div>
      </article>

      <!-- Sidebar: Playlist Panel -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <!-- Now Playing -->
          <div class="mb-4 p-3 rounded-lg bg-brand-light border border-white/5">
            <p class="text-[10px] text-text-muted/40 uppercase tracking-wider mb-1">正在播放</p>
            <p id="now-playing-title" class="text-sm font-medium text-accent truncate">尚未播放</p>
            <audio id="section-audio" class="w-full mt-2" controls preload="metadata" style="height: 32px;"></audio>
            <div class="flex items-center justify-between mt-2">
              <div class="flex items-center gap-1">
                {[0.75, 1, 1.25, 1.5, 2].map(speed => (
                  <button
                    class={`speed-btn text-[10px] px-1.5 py-0.5 rounded transition-colors ${speed === 1 ? 'bg-accent text-white' : 'bg-white/5 text-text-muted/50 hover:bg-accent/20 hover:text-accent'}`}
                    data-speed={speed}
                  >
                    {speed}x
                  </button>
                ))}
              </div>
            </div>
          </div>

          <!-- Playlist -->
          <div class="flex items-center justify-between mb-2">
            <p class="text-xs font-bold text-text-muted/50 uppercase tracking-wider">播放清單</p>
            <button id="mark-all-unread" class="text-[10px] text-text-muted/30 hover:text-accent transition-colors">全部標為未聽</button>
          </div>
          <div class="space-y-0.5" id="playlist">
            {headings.filter(h => h.depth === 2).map((h, i) => (
              <div
                class="playlist-item flex items-center gap-2 p-2.5 rounded-lg cursor-pointer transition-all hover:bg-white/5 group"
                data-index={i}
                data-slug={h.slug}
                data-title={h.text}
              >
                <div class="flex-shrink-0 w-5 h-5 rounded-full bg-white/5 group-hover:bg-accent/20 flex items-center justify-center">
                  <span class="play-icon text-[9px] text-text-muted/40 group-hover:text-accent">▶</span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="item-title text-xs font-medium text-text-muted/70 group-hover:text-text truncate">{h.text}</p>
                </div>
                <span class="listen-badge text-[9px] px-1.5 py-0.5 rounded bg-white/5 text-text-muted/30 hidden">已聽</span>
              </div>
            ))}
          </div>

          <!-- Full version -->
          {entry.data.audio && (
            <div class="mt-4 pt-4 border-t border-white/5">
              <button id="play-full" class="w-full text-xs text-center py-2 rounded-lg bg-white/5 text-text-muted/50 hover:bg-accent/10 hover:text-accent transition-colors">
                🎙 播放完整版
              </button>
            </div>
          )}
        </div>
      </aside>
    </div>
  </div>

  <!-- Playlist controller -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const audio = document.getElementById('section-audio');
      const mainPlayer = document.getElementById('main-player');
      const nowPlaying = document.getElementById('now-playing-title');
      const items = document.querySelectorAll('.playlist-item');
      const speedBtns = document.querySelectorAll('.speed-btn');
      const playFullBtn = document.getElementById('play-full');
      const markAllBtn = document.getElementById('mark-all-unread');

      const dateMatch = window.location.pathname.match(/(\d{4}-\d{2}-\d{2})/);
      const dateStr = dateMatch ? dateMatch[1] : '';
      const audioBase = '/audio/' + dateStr + '/';

      let currentIndex = -1;
      let playbackSpeed = 1;
      let listened = new Set();

      // Load listened state from localStorage
      const storageKey = 'daily-listened-' + dateStr;
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || '[]');
        saved.forEach(i => listened.add(i));
        updateListenedUI();
      } catch(e) {}

      function buildAudioSrc(idx) {
        const item = items[idx];
        if (!item) return '';
        const slug = item.dataset.slug;
        const padded = String(idx + 1).padStart(2, '0');
        return audioBase + padded + '-' + slug + '.mp3';
      }

      function playIndex(idx) {
        if (idx < 0 || idx >= items.length) return;
        currentIndex = idx;
        const item = items[idx];
        const title = item.dataset.title;

        // Update UI
        items.forEach(it => {
          it.classList.remove('bg-accent/10', 'border-l-2', 'border-accent');
          it.querySelector('.play-icon').textContent = '▶';
        });
        item.classList.add('bg-accent/10', 'border-l-2', 'border-accent');
        item.querySelector('.play-icon').textContent = '⏸';
        nowPlaying.textContent = title;

        // Play
        audio.src = buildAudioSrc(idx);
        audio.playbackRate = playbackSpeed;
        audio.play();

        // Scroll content to section
        const target = document.getElementById(item.dataset.slug);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });

        // Pause main player if playing
        if (mainPlayer && !mainPlayer.paused) mainPlayer.pause();
      }

      function markListened(idx) {
        listened.add(idx);
        localStorage.setItem(storageKey, JSON.stringify([...listened]));
        updateListenedUI();
      }

      function updateListenedUI() {
        items.forEach((item, i) => {
          const badge = item.querySelector('.listen-badge');
          const titleEl = item.querySelector('.item-title');
          if (listened.has(i)) {
            badge.classList.remove('hidden');
            titleEl.classList.add('text-text-muted/40');
          } else {
            badge.classList.add('hidden');
            titleEl.classList.remove('text-text-muted/40');
          }
        });
      }

      // Click playlist item
      items.forEach((item, i) => {
        item.addEventListener('click', () => {
          if (currentIndex === i && !audio.paused) {
            audio.pause();
            item.querySelector('.play-icon').textContent = '▶';
            return;
          }
          playIndex(i);
        });
      });

      // Auto-advance: when one section ends, wait 2s then play next
      audio.addEventListener('ended', () => {
        markListened(currentIndex);
        items[currentIndex].querySelector('.play-icon').textContent = '✓';

        if (currentIndex < items.length - 1) {
          // Wait 2 seconds then play next
          nowPlaying.textContent = '下一段即將播放...';
          setTimeout(() => playIndex(currentIndex + 1), 2000);
        } else {
          nowPlaying.textContent = '全部播放完畢';
          items[currentIndex].classList.remove('bg-accent/10');
        }
      });

      // Speed control
      speedBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          playbackSpeed = parseFloat(btn.dataset.speed);
          audio.playbackRate = playbackSpeed;
          if (mainPlayer) mainPlayer.playbackRate = playbackSpeed;
          speedBtns.forEach(b => {
            b.classList.remove('bg-accent', 'text-white');
            b.classList.add('bg-white/5', 'text-text-muted/50');
          });
          btn.classList.add('bg-accent', 'text-white');
          btn.classList.remove('bg-white/5', 'text-text-muted/50');
        });
      });

      // Mark all as unread
      markAllBtn.addEventListener('click', () => {
        listened.clear();
        localStorage.removeItem(storageKey);
        updateListenedUI();
      });

      // Play full version
      if (playFullBtn && mainPlayer) {
        playFullBtn.addEventListener('click', () => {
          audio.pause();
          items.forEach(it => {
            it.classList.remove('bg-accent/10', 'border-l-2', 'border-accent');
            it.querySelector('.play-icon').textContent = '▶';
          });
          nowPlaying.textContent = '完整版播放中';
          mainPlayer.playbackRate = playbackSpeed;
          mainPlayer.currentTime = 0;
          mainPlayer.play();
        });
      }

      // Listen badge click to toggle
      items.forEach((item, i) => {
        const badge = item.querySelector('.listen-badge');
        badge.addEventListener('click', (e) => {
          e.stopPropagation();
          if (listened.has(i)) {
            listened.delete(i);
          } else {
            listened.add(i);
          }
          localStorage.setItem(storageKey, JSON.stringify([...listened]));
          updateListenedUI();
        });
      });

      // Scroll highlight
      const proseH2s = document.querySelectorAll('.prose h2[id]');
      if (proseH2s.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                const slug = entry.target.id;
                items.forEach(item => {
                  const t = item.querySelector('.item-title');
                  if (item.dataset.slug === slug) {
                    t.classList.add('text-text');
                  } else if (!listened.has(parseInt(item.dataset.index))) {
                    t.classList.remove('text-text');
                  }
                });
              }
            });
          },
          { rootMargin: '-80px 0px -60% 0px' }
        );
        proseH2s.forEach(h => observer.observe(h));
      }
    });
  </script>
</BaseLayout>
