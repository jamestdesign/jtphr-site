---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import todosRaw from '../data/todos.json';

interface TodoRef { path: string; id: string; }
interface Todo { category: string; section: string; title: string; date: string; doneDate: string; done: boolean; details: string[]; refs: TodoRef[]; source: string; }
const todos = todosRaw as Todo[];
const allNotes = await getCollection('kb');

// Stats
const totalNotes = allNotes.length;
const totalTodos = todos.length;
const doneTodos = todos.filter(t => t.done).length;
const pendingTodos = totalTodos - doneTodos;

// Group todos by category
const categories = [...new Set(todos.map(t => t.category))];

// Recent notes (last 5)
const recentNotes = allNotes
  .filter(n => n.data.date)
  .sort((a, b) => new Date(b.data.date!).getTime() - new Date(a.data.date!).getTime())
  .slice(0, 8);

// Note stats by category
const notesByCategory: Record<string, number> = {};
allNotes.forEach(n => {
  const cat = n.data.category || '未分類';
  notesByCategory[cat] = (notesByCategory[cat] || 0) + 1;
});
---

<BaseLayout title="儀表板" description="JTpHR 個人儀表板">
  <section class="max-w-6xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold mb-8">儀表板</h1>

    <!-- Stats Cards -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-brand-light border border-white/5 rounded-lg p-5">
        <p class="text-3xl font-bold text-accent">{totalNotes}</p>
        <p class="text-sm text-text-muted mt-1">知識庫筆記</p>
      </div>
      <div class="bg-brand-light border border-white/5 rounded-lg p-5">
        <p class="text-3xl font-bold text-yellow-400">{pendingTodos}</p>
        <p class="text-sm text-text-muted mt-1">待辦事項</p>
      </div>
      <div class="bg-brand-light border border-white/5 rounded-lg p-5">
        <p class="text-3xl font-bold text-green-400">{doneTodos}</p>
        <p class="text-sm text-text-muted mt-1">已完成</p>
      </div>
      <div class="bg-brand-light border border-white/5 rounded-lg p-5">
        <p class="text-3xl font-bold text-text">{Object.keys(notesByCategory).length}</p>
        <p class="text-sm text-text-muted mt-1">筆記分類</p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- TODO List (2/3 width) -->
      <div class="lg:col-span-2">
        <h2 class="text-2xl font-bold mb-6">待辦事項</h2>

        {categories.map(cat => {
          const catTodos = todos.filter(t => t.category === cat);
          const catPending = catTodos.filter(t => !t.done);
          const catDone = catTodos.filter(t => t.done);
          const pendingSections = [...new Set(catPending.map(t => t.section))];
          const doneSections = [...new Set(catDone.map(t => t.section))];

          const catColors = {
            '基建': 'border-blue-500',
            'Ideas': 'border-purple-500',
            '股票': 'border-green-500',
          };

          return (
            <div class={`mb-8 border-l-4 ${catColors[cat] || 'border-gray-500'} pl-4`}>
              <div class="flex items-center gap-3 mb-4">
                <h3 class="text-lg font-bold">{cat}</h3>
                <span class="text-xs px-2 py-0.5 rounded-full bg-white/5 text-text-muted">
                  {catPending.length} 待完成
                </span>
                {catDone.length > 0 && (
                  <span class="text-xs px-2 py-0.5 rounded-full bg-green-500/10 text-green-400">
                    {catDone.length} 已完成
                  </span>
                )}
              </div>

              {/* Pending items */}
              {pendingSections.map(sec => {
                const secTodos = catPending.filter(t => t.section === sec);
                return (
                  <div class="mb-4">
                    <p class="text-xs text-text-muted/60 uppercase tracking-wider mb-2">{sec}</p>
                    <div class="space-y-2">
                      {secTodos.map(todo => (
                        <div class="p-3 rounded-lg bg-brand-light border border-white/5">
                          <div class="flex items-start gap-3">
                            <span class="mt-0.5 w-4 h-4 rounded border border-white/20 flex-shrink-0"></span>
                            <div class="flex-1 min-w-0">
                              <p class="text-sm font-medium">{todo.title}</p>
                              {todo.source && (
                                <p class="text-[10px] text-text-muted/60 mt-1">來源：{todo.source}</p>
                              )}
                              {todo.date && (
                                <p class="text-[10px] text-text-muted/40 mt-0.5">建立於 {todo.date}</p>
                              )}
                            </div>
                          </div>
                          {todo.refs.length > 0 && (
                            <div class="mt-2 ml-7 flex flex-wrap gap-1.5">
                              {todo.refs.map(ref => (
                                ref.id ? (
                                  <a href={`/kb/${ref.id}`} class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent hover:bg-accent/20 transition-colors">
                                    📄 {ref.path.split('/').pop()?.replace('.md', '')}
                                  </a>
                                ) : (
                                  <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded bg-white/5 text-text-muted/50">
                                    📄 {ref.path.split('/').pop()?.replace('.md', '')}
                                  </span>
                                )
                              ))}
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}

              {/* Completed items - collapsible */}
              {catDone.length > 0 && (
                <details class="mt-4">
                  <summary class="cursor-pointer text-sm text-green-400/70 hover:text-green-400 transition-colors select-none flex items-center gap-2">
                    <span class="text-xs">▶</span> 查看 {catDone.length} 個已完成項目
                  </summary>
                  <div class="mt-3 space-y-2">
                    {catDone.map(todo => (
                      <div class="p-3 rounded-lg bg-white/2 opacity-70">
                        <div class="flex items-start gap-3">
                          <span class="mt-0.5 w-4 h-4 rounded border bg-green-500/20 border-green-500 flex-shrink-0 flex items-center justify-center text-[10px] text-green-400">✓</span>
                          <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium line-through text-text-muted">{todo.title}</p>
                            <p class="text-[10px] text-green-400/50 mt-1">
                              ✅ 完成於 {todo.doneDate || todo.date || '未記錄'}
                            </p>
                          </div>
                        </div>
                        {todo.refs.length > 0 && (
                          <div class="mt-2 ml-7 flex flex-wrap gap-1.5">
                            {todo.refs.map(ref => (
                              ref.id ? (
                                <a href={`/kb/${ref.id}`} class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded bg-accent/10 text-accent hover:bg-accent/20 transition-colors">
                                  📄 {ref.path.split('/').pop()?.replace('.md', '')}
                                </a>
                              ) : (
                                <span class="inline-flex items-center gap-1 text-[10px] px-2 py-0.5 rounded bg-white/5 text-text-muted/50">
                                  📄 {ref.path.split('/').pop()?.replace('.md', '')}
                                </span>
                              )
                            ))}
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </details>
              )}
            </div>
          );
        })}
      </div>

      <!-- Sidebar (1/3 width) -->
      <div>
        <!-- Recent Notes -->
        <h2 class="text-2xl font-bold mb-6">最近筆記</h2>
        <div class="space-y-3 mb-8">
          {recentNotes.map(note => (
            <a href={`/kb/${note.id}`} class="block p-3 rounded-lg bg-brand-light border border-white/5 hover:border-accent/30 transition-colors group">
              <p class="text-sm font-medium group-hover:text-accent transition-colors line-clamp-1">{note.data.title}</p>
              <div class="flex items-center gap-2 mt-1">
                <span class="text-[10px] text-text-muted/50">{note.data.category}</span>
                {note.data.date && (
                  <span class="text-[10px] text-text-muted/30">{new Date(note.data.date).toLocaleDateString('zh-TW')}</span>
                )}
              </div>
            </a>
          ))}
        </div>

        <!-- Category Distribution -->
        <h2 class="text-2xl font-bold mb-6">分類統計</h2>
        <div class="space-y-2">
          {Object.entries(notesByCategory).sort((a, b) => b[1] - a[1]).map(([cat, count]) => (
            <div class="flex items-center justify-between p-2">
              <span class="text-sm text-text-muted">{cat}</span>
              <div class="flex items-center gap-2">
                <div class="w-24 h-1.5 bg-white/5 rounded-full overflow-hidden">
                  <div class="h-full bg-accent rounded-full" style={`width: ${(count / totalNotes) * 100}%`}></div>
                </div>
                <span class="text-xs text-text-muted/50 w-6 text-right">{count}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
