---
import BaseLayout from '../../layouts/BaseLayout.astro';

const categories = ['全部', '旅行', '街拍', '人像', '生活'];
---

<BaseLayout title="作品集" description="JTpHR 攝影作品集 — 旅行、街拍、人像、生活紀錄">
  <section class="max-w-7xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold mb-2">作品集</h1>
    <p class="text-text-muted mb-12">用影像說故事</p>

    <!-- Category Filter -->
    <div class="flex gap-3 mb-12 flex-wrap">
      {categories.map((cat, i) => (
        <button
          class:list={[
            'px-5 py-2 rounded-full text-sm font-medium transition-colors',
            i === 0 ? 'bg-accent text-white' : 'border border-white/20 text-text-muted hover:border-accent hover:text-accent',
          ]}
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Gallery Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {[1, 2, 3, 4, 5, 6].map((i) => (
        <div class="group relative aspect-[4/3] overflow-hidden rounded-lg bg-brand-light cursor-pointer">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity z-10"></div>
          <div class="absolute bottom-4 left-4 right-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity">
            <p class="text-sm font-medium">作品標題</p>
            <p class="text-xs text-text-muted">地點 · 2026</p>
          </div>
          <div class="w-full h-full flex items-center justify-center text-text-muted/30">
            <svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="0.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>
      ))}
    </div>

    <p class="text-center text-text-muted mt-16">上傳攝影作品後，這裡會自動填入你的照片</p>
  </section>
</BaseLayout>
