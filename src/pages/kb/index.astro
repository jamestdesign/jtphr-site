---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('kb');
const notes = allNotes.sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date).getTime() : 0;
  const db = b.data.date ? new Date(b.data.date).getTime() : 0;
  return db - da;
});

// Get unique categories and tags
const categories = [...new Set(notes.map(n => n.data.category))].sort();
const allTags = [...new Set(notes.flatMap(n => n.data.tags || []))].sort();
---

<BaseLayout title="知識庫" description="JTpHR 知識庫 — AI 工具、股票研究、攝影技術筆記">
  <section class="max-w-6xl mx-auto px-6 py-24">
    <h1 class="text-4xl font-bold mb-2">知識庫</h1>
    <p class="text-text-muted mb-8">{notes.length} 篇筆記</p>

    <!-- Search -->
    <div class="mb-8">
      <input
        type="text"
        id="search"
        placeholder="搜尋筆記..."
        class="w-full px-4 py-3 bg-brand-light border border-white/10 rounded-lg text-text placeholder-text-muted/50 focus:border-accent focus:outline-none"
      />
    </div>

    <!-- Category Filter -->
    <div class="flex gap-2 mb-8 flex-wrap">
      <button class="filter-btn active px-4 py-1.5 rounded-full text-sm font-medium bg-accent text-white" data-category="all">
        全部 ({notes.length})
      </button>
      {categories.map(cat => {
        const count = notes.filter(n => n.data.category === cat).length;
        return (
          <button class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium border border-white/15 text-text-muted hover:border-accent hover:text-accent transition-colors" data-category={cat}>
            {cat} ({count})
          </button>
        );
      })}
    </div>

    <!-- Notes Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="notes-grid">
      {notes.map(note => (
        <a
          href={`/kb/${note.id}`}
          class="note-card block p-5 rounded-lg bg-brand-light border border-white/5 hover:border-accent/30 transition-all group"
          data-category={note.data.category}
          data-title={note.data.title.toLowerCase()}
          data-tags={(note.data.tags || []).join(' ').toLowerCase()}
        >
          <div class="flex items-start justify-between mb-2">
            <span class="text-xs px-2 py-0.5 rounded bg-white/5 text-text-muted">{note.data.category}</span>
            {note.data.date && (
              <span class="text-xs text-text-muted/50">
                {new Date(note.data.date).toLocaleDateString('zh-TW')}
              </span>
            )}
          </div>
          <h3 class="font-medium text-sm leading-snug group-hover:text-accent transition-colors mb-2 line-clamp-2">
            {note.data.title}
          </h3>
          {(note.data.tags || []).length > 0 && (
            <div class="flex gap-1 flex-wrap mt-auto">
              {(note.data.tags || []).slice(0, 3).map(tag => (
                <span class="text-[10px] px-1.5 py-0.5 rounded bg-white/5 text-text-muted/60">#{tag}</span>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <script>
    // Search
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const cards = document.querySelectorAll('.note-card') as NodeListOf<HTMLElement>;

    searchInput?.addEventListener('input', () => {
      const query = searchInput.value.toLowerCase();
      cards.forEach(card => {
        const title = card.dataset.title || '';
        const tags = card.dataset.tags || '';
        const cat = card.dataset.category || '';
        const match = title.includes(query) || tags.includes(query) || cat.includes(query);
        card.style.display = match ? '' : 'none';
      });
    });

    // Category filter
    const filterBtns = document.querySelectorAll('.filter-btn') as NodeListOf<HTMLButtonElement>;
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        filterBtns.forEach(b => {
          b.classList.remove('active', 'bg-accent', 'text-white');
          b.classList.add('border', 'border-white/15', 'text-text-muted');
        });
        btn.classList.add('active', 'bg-accent', 'text-white');
        btn.classList.remove('border', 'border-white/15', 'text-text-muted');

        const cat = btn.dataset.category;
        cards.forEach(card => {
          if (cat === 'all' || card.dataset.category === cat) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
