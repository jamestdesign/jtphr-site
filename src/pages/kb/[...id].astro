---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import NotePreview from '../../components/NotePreview.astro';
import ShareButton from '../../components/ShareButton.astro';
import { getCollection, render } from 'astro:content';
import shareMap from '../../data/share-map.json';

export async function getStaticPaths() {
  const notes = await getCollection('kb');
  return notes.map(note => ({
    params: { id: note.id },
    props: { note, allNotes: notes },
  }));
}

const { note, allNotes } = Astro.props;
const shareId = (shareMap as Record<string, string>)[`kb/${note.id}`] || '';
const { Content } = await render(note);

// Multi-agent collaboration credits (v1 schema)
const creatorLabels: Record<string, string> = {
  james: 'James',
  claude_robin: 'Claude（管理）',
  robert: 'Robert',
  external: '外部來源',
};
const data = note.data as Record<string, any>;
const creator: string | undefined = data.creator;
const coCreators: string[] = Array.isArray(data.co_creators) ? data.co_creators : [];
const allCreators = [creator, ...coCreators].filter(Boolean) as string[];
const version: number = typeof data.version === 'number' ? data.version : 1;

// Build note lookup for preview + linking
const noteLookup = allNotes.map(n => ({
  id: n.id,
  title: n.data.title,
  category: n.data.category || '',
  tags: (n.data.tags || []).join(','),
  // First 100 chars of body as excerpt (strip markdown)
  excerpt: n.body?.replace(/^---[\s\S]*?---\n?/, '').replace(/[#*`>\[\]!_|]/g, '').replace(/\n+/g, ' ').trim().slice(0, 120) || '',
}));
---

<BaseLayout title={note.data.title} description={`${note.data.title} — JTpHR 知識庫`}>
  <!-- Hidden data for note preview -->
  <div class="hidden">
    {noteLookup.map(n => (
      <span
        data-note-id={n.id}
        data-note-title={n.title}
        data-note-category={n.category}
        data-note-excerpt={n.excerpt}
        data-note-tags={n.tags}
        data-note-url={`/kb/${n.id}`}
      ></span>
    ))}
  </div>

  <article class="max-w-4xl mx-auto px-6 py-24">
    <!-- Header -->
    <div class="mb-8 pb-8 border-b border-white/5">
      <div class="flex items-center gap-3 mb-4 flex-wrap">
        <a href="/kb" class="text-xs text-text-muted hover:text-accent transition-colors">&larr; 返回知識庫</a>
        <span class="text-xs px-2 py-0.5 rounded bg-white/5 text-text-muted">{note.data.category}</span>
        {shareId && <ShareButton shareId={shareId} />}
        {note.data.date && (
          <span class="text-xs text-text-muted/50">
            {new Date(note.data.date).toLocaleDateString('zh-TW')}
          </span>
        )}
      </div>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight">{note.data.title}</h1>
      {(note.data['來源'] || note.data['連結']) && (
        <div class="mt-3 flex flex-col gap-1">
          {note.data['來源'] && (
            <p class="text-xs text-text-muted">來源：{note.data['來源']}</p>
          )}
          {note.data['連結'] && (
            <a href={note.data['連結']} target="_blank" class="text-xs text-accent hover:underline break-all">
              🔗 {note.data['連結']}
            </a>
          )}
        </div>
      )}
      {allCreators.length > 0 && (
        <p class="text-xs text-text-muted/70 mt-2">
          ✍️ {allCreators.map(c => creatorLabels[c] || c).join(' × ')}
          {version > 1 && <span class="ml-2 text-text-muted/50">· 第 {version} 版</span>}
        </p>
      )}
      {(note.data.tags || []).length > 0 && (
        <div class="flex gap-2 flex-wrap mt-4">
          {(note.data.tags || []).map(tag => (
            <span class="text-xs px-2 py-1 rounded-full border border-white/10 text-text-muted">#{tag}</span>
          ))}
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:text-text prose-headings:font-bold
      prose-h2:text-2xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:pb-2 prose-h2:border-b prose-h2:border-white/5
      prose-h3:text-xl prose-h3:mt-8 prose-h3:mb-3
      prose-p:text-text-muted prose-p:leading-relaxed
      prose-a:text-accent prose-a:no-underline hover:prose-a:underline
      prose-strong:text-text
      prose-code:text-accent prose-code:bg-white/5 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm
      prose-pre:bg-brand prose-pre:border prose-pre:border-white/5 prose-pre:rounded-lg
      prose-blockquote:border-accent prose-blockquote:bg-white/3 prose-blockquote:rounded-r-lg prose-blockquote:py-1
      prose-table:text-sm
      prose-th:text-text prose-th:bg-white/5 prose-th:px-3 prose-th:py-2
      prose-td:px-3 prose-td:py-2 prose-td:border-white/5
      prose-li:text-text-muted
      prose-img:rounded-lg
    ">
      <Content />
    </div>
  </article>
  <Lightbox />
  <NotePreview />

  <!-- Convert related note references to clickable links with preview -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      // Build title → id lookup from data attributes
      const titleToId = {};
      document.querySelectorAll('[data-note-id]').forEach(el => {
        const title = el.dataset.noteTitle || '';
        const id = el.dataset.noteId || '';
        // Index by various possible reference formats
        titleToId[title] = id;
        // Also index by filename-like patterns (without path prefix)
        const parts = id.split('__');
        const shortName = parts[parts.length - 1];
        titleToId[shortName] = id;
      });

      // Find related notes section and convert text references to links
      const prose = document.querySelector('.prose');
      if (!prose) return;

      // Walk through all list items in the "相關筆記" section
      const headings = prose.querySelectorAll('h2');
      headings.forEach(h2 => {
        if (!h2.textContent.includes('相關筆記')) return;

        // Get the next sibling UL
        let ul = h2.nextElementSibling;
        while (ul && ul.tagName !== 'UL') ul = ul.nextElementSibling;
        if (!ul) return;

        ul.querySelectorAll('li').forEach(li => {
          const text = li.textContent.trim();
          // Try to match "NoteName — description" or just "NoteName"
          const parts = text.split('—').map(s => s.trim());
          const refName = parts[0];
          const desc = parts[1] || '';

          // Find matching note
          let matchedId = null;
          for (const [key, id] of Object.entries(titleToId)) {
            // Fuzzy match: reference name contained in title or filename
            if (key.toLowerCase().includes(refName.toLowerCase().replace(/\s/g, '_')) ||
                refName.toLowerCase().replace(/\s/g, '_').includes(key.toLowerCase())) {
              matchedId = id;
              break;
            }
          }

          if (matchedId) {
            li.innerHTML = `<a href="/kb/${matchedId}" class="text-accent hover:underline">${refName}</a>${desc ? ' — ' + desc : ''}`;
          }
        });
      });
    });
  </script>
</BaseLayout>
