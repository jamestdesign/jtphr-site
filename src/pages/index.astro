---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="首頁">
  <!-- Hero Section -->
  <section class="relative h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-brand/60 via-surface/40 to-surface z-10"></div>
    <div class="absolute inset-0 bg-brand bg-cover bg-center"></div>
    <div class="relative z-20 text-center px-6">
      <h1 class="text-6xl md:text-8xl font-bold tracking-widest mb-4">JTpHR</h1>
      <p class="text-xl md:text-2xl text-text-muted font-light tracking-wide mb-8">
        用鏡頭記錄生活的每一刻
      </p>
      <div class="flex gap-4 justify-center">
        <a
          href="/portfolio"
          class="px-8 py-3 bg-accent text-white rounded-full hover:bg-accent/80 transition-colors font-medium"
        >
          瀏覽作品
        </a>
        <a
          href="/blog"
          class="px-8 py-3 border border-white/20 rounded-full hover:border-accent hover:text-accent transition-colors font-medium"
        >
          閱讀遊記
        </a>
      </div>
    </div>
    <div class="absolute bottom-8 z-20 animate-bounce">
      <svg class="w-6 h-6 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- Featured Work -->
  <section class="max-w-7xl mx-auto px-6 py-24">
    <h2 class="text-3xl font-bold mb-2">精選作品</h2>
    <p class="text-text-muted mb-12">最新攝影作品集</p>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[1, 2, 3].map((i) => (
        <a href="/portfolio" class="group relative aspect-[4/3] overflow-hidden rounded-lg bg-brand-light">
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity z-10"></div>
          <div class="absolute bottom-4 left-4 z-20 opacity-0 group-hover:opacity-100 transition-opacity">
            <p class="text-sm font-medium">作品集 {i}</p>
            <p class="text-xs text-text-muted">即將上線</p>
          </div>
          <div class="w-full h-full flex items-center justify-center text-text-muted">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest Blog -->
  <section class="max-w-7xl mx-auto px-6 py-24 border-t border-white/5">
    <h2 class="text-3xl font-bold mb-2">最新遊記</h2>
    <p class="text-text-muted mb-12">旅行中的故事與影像</p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {[1, 2].map((i) => (
        <a href="/blog" class="group block">
          <div class="aspect-[16/9] rounded-lg overflow-hidden bg-brand-light mb-4 flex items-center justify-center text-text-muted">
            <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <p class="text-xs text-text-muted mb-1">2026 年 3 月</p>
          <h3 class="text-lg font-medium group-hover:text-accent transition-colors">遊記標題 {i}</h3>
          <p class="text-sm text-text-muted mt-1">即將上線...</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
